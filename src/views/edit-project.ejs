<%- include('partials/header') %>

<%
    const dateObj = new Date(project.date);
    const formattedDate = isNaN(dateObj.getTime())
        ? ''
        : dateObj.toISOString().split('T')[0];
%>

<section class="page-section">
    <h2 class="section-title"><%= pageTitle %></h2>

    <form action="/edit-project/<%= project.project_id %>" method="POST" class="form-container">
        <div class="form-group">
            <label for="title">Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.title %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="4"
                required
            ><%= project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= project.location %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= formattedDate %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <% organizations.forEach(org => { %>
                    <option
                        value="<%= org.organization_id %>"
                        <%= Number(org.organization_id) === Number(project.organization_id) ? 'selected' : '' %>
                    >
                        <%= org.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <button type="submit">Update Project</button>
    </form>

    <p style="margin-top: 1.5rem;">
        <a href="/project/<%= project.project_id %>">&larr; Back to Project Details</a>
    </p>
</section>

<%- include('partials/footer') %>