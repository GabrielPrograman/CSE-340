<%- include('partials/header') %>

<section class="page-section">
    <h2 class="section-title"><%= pageTitle %></h2>
    <p class="section-intro">Explore current initiatives where you can donate your time, skills, and support.</p>

    <p style="margin-top: 1rem;">
        <a href="/new-project">Add a New Service Project</a>
    </p>
    
    <ul class="projects-list" style="margin-left: 1.5rem; line-height: 1.8; color: #1f2937;">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>: <%= project.description %> 
                    <br><small>Location: <%= project.location %> | Org: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></small>
                </li>
            <% }) %>
        <% } else { %>
            <p>No projects found.</p>
        <% } %>
    </ul>
</section>

<%- include('partials/footer') %>