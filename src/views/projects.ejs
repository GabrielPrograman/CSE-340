<%- include('partials/header') %>

<section class="page-section">
    <h2 class="section-title"><%= pageTitle %></h2>
    <p class="section-intro">Explore current initiatives where you can donate your time, skills, and support.</p>
    
    <ul class="projects-list" style="margin-left: 1.5rem; line-height: 1.8; color: #1f2937;">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li>
                    <strong><%= project.title %></strong>: <%= project.description %> 
                    <br><small>Location: <%= project.location %> | Org: <%= project.organization_name %></small>
                </li>
            <% }) %>
        <% } else { %>
            <p>No projects found.</p>
        <% } %>
    </ul>
</section>

<%- include('partials/footer') %>