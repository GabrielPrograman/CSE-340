<%- include('partials/header') %>

<section class="page-section">
    <h2 class="section-title"><%= pageTitle %></h2>
    <p class="section-intro">Browse service categories to find projects aligned with your interests.</p>

    <ul class="categories-list" style="margin-left: 1.5rem; line-height: 1.8; color: #1f2937;">
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>"><strong><%= category.name %></strong></a>
                </li>
            <% }) %>
        <% } else { %>
            <p>No categories found.</p>
        <% } %>
    </ul>

    <p style="margin-top: 1.5rem;">
        <a href="/new-category">Add New Category</a>
    </p>
</section>

<%- include('partials/footer') %>